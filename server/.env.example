# MandateGuard server configuration
# Copy this file to .env and fill in your own values.
# NEVER commit .env. NEVER put these values in the React frontend.

# ── NVIDIA NIM (Phase 5) ────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_nim_model_name

# ── x402 + Algorand (Phase 6) ───────────────────────────────
# AVM_ADDRESS is the PUBLIC Algorand address that receives the small
# Test USDC API fee. It is an account number, never a secret.
# Never put a seed phrase, mnemonic or private key in this file.
AVM_ADDRESS=your_algorand_testnet_address_here

FACILITATOR_URL=https://facilitator.goplausible.xyz

# TestNet only. MainNet is not supported by this project.
ALGORAND_NETWORK=testnet

# ── MySQL / MariaDB storage ─────────────────────────────────
# XAMPP defaults: user root with an empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mandateguard

# ── Telegram (the user's control channel) ───────────────────
# From @BotFather. This token controls the bot - treat it like a password.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# The ONLY chat allowed to command the agent. Get it from @userinfobot.
# Without this allowlist, anyone who finds the bot could spend the agent's money.
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# ── The agent's own wallet ──────────────────────────────────
# A DEDICATED TestNet account the agent spends from on its own, so it can buy
# without a human signing in a browser. This is NOT your personal wallet.
#
# Generate a fresh one - never reuse an account you hold funds in:
#   node -e "const a=require('algosdk').generateAccount();console.log(a.addr.toString());console.log(require('algosdk').secretKeyToMnemonic(a.sk))"
#
# Then fund it with a little TestNet ALGO and run: npm run agent:optin
#
# The safety here is not that this key is hidden. It can sign anything.
# The safety is that MandateGuard decides what it is allowed to buy.
AGENT_ADDRESS=your_agent_testnet_address_here
AGENT_MNEMONIC=your twenty five word agent mnemonic goes here
