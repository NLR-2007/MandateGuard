{
  "name": "mandateguard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MandateGuard Policy Engine - Phase 4 (deterministic verification, in-memory store)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test src/services/mandateVerifier.test.ts src/services/policyParser.test.ts src/services/aiOrderAgent.test.ts",
    "test:nim": "node --env-file-if-exists=.env --import tsx scripts/testNim.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
